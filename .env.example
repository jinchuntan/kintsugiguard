# KintsugiGuard AI - Environment Configuration
# The app works fully in mock mode without any API keys.

KINTSUGIGUARD_AI_PROVIDER=mock

# Gemini (Google AI Studio)
GEMINI_API_KEY=
KINTSUGIGUARD_GEMINI_MODEL=gemini-2.0-flash

# OpenAI (optional)
OPENAI_API_KEY=
KINTSUGIGUARD_OPENAI_MODEL=gpt-4.1-mini
KINTSUGIGUARD_OPENAI_BASE_URL=https://api.openai.com/v1

# Anthropic (optional)
ANTHROPIC_API_KEY=
KINTSUGIGUARD_ANTHROPIC_MODEL=claude-sonnet-4-20250514

# Vision (optional, requires OpenAI-compatible endpoint)
KINTSUGIGUARD_VISION_MODEL=meta-llama/llama-4-scout-17b-16e-instruct
